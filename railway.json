{
  "build": {
    "builder": "NIXPACKS",
    "python": {
      "version": "3.11"
    },
    "nixPkgs": [
      "python311",
      "tesseract",
      "tesseract.eng",
      "openssl",
      "pkg-config",
      "libGL",
      "mesa"
    ]
  },
  "deploy": {
    "startCommand": "uvicorn api.main:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 10,
    "timeout": 1200
  }
}
