{
  "build": {
    "builder": "NIXPACKS",
    "python": {
      "version": "3.11"
    }
  },
  "deploy": {
    "startCommand": "uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000} --log-level debug",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 500,
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 10
  }
}
